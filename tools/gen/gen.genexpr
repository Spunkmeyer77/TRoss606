  if (cp_pos >= 512) { cp_pos = 0; }
  cp_c0 = 0; cp_c1 = 0; cp_c2 = 0; cp_c3 = 0;
  cp_base = cp_pos + 511;
  for (j = 0; j < cp_tapn; j = j + 1) {
    cp_s = peek(cp_ring, cp_base - j);
