if (cp_active > 0) {
  cp_g = (noise() + noise() + noise() + noise() + noise() + noise()) * 0.70710678118654752;
  poke(cp_ring, cp_g, cp_pos);
  poke(cp_ring, cp_g, cp_pos + 512);
