  lt_burst = lt_nr * lt_bue;
  lt_exc = lt_ln2 * (0.5 * lt_snap + 0.03 * lt_burst) + lt_hn2 * (0.03 * lt_snap + 0.009 * lt_burst) + lt_tn2 * 0.01 * lt_nr * lt_tne;
  lt_fs1 = lt_fsh_b0 * lt_hs + lt_fsh_z1;
  lt_fsh_z1 = lt_fsh_b1 * lt_hs - lt_fsh_a1 * lt_fs1 + lt_fsh_z2;
  lt_fsh_z2 = lt_fsh_b2 * lt_hs - lt_fsh_a2 * lt_fs1;
  lt_fs2 = lt_fsl_b0 * lt_fs1 + lt_fsl_z1;
  lt_fsl_z1 = lt_fsl_b1 * lt_fs1 - lt_fsl_a1 * lt_fs2 + lt_fsl_z2;
  lt_fsl_z2 = lt_fsl_b2 * lt_fs1 - lt_fsl_a2 * lt_fs2;
  lt_exc = lt_exc + lt_fs2 * 1.1 * lt_snap;
  lt_out = ((lt_main + lt_lower + lt_upper) * lt_br + lt_strike + lt_exc) * 0.8;
  lt_me = lt_me * lt_mpole;
  lt_glide = lt_glide * lt_gpole;
  lt_le = lt_le * lt_lpole;
  lt_se = lt_se * lt_spole;
  lt_sne = lt_sne * lt_snp;
  lt_bue = lt_bue * lt_bup;
  lt_tne = lt_tne * lt_tnp;
  if (lt_me <= 0.000005 && 0.0 * lt_le <= 0.000005) { lt_active = 0; }
}
// ---- ht ----
ht_fire = 0;
ht_vel = 0;
if (tr_ht != ht_trlast) {
  ht_trlast = tr_ht;
  ht_vel = tr_ht - 128 * floor(tr_ht / 128);
  ht_fire = 1;
}
if (ht_sq > 0) { ht_vel = max(ht_vel, seq_vel); ht_fire = 1; }
if (ht_fire > 0) {
  ht_vg = velgain(ht_vel, acc);
  ht_dec = clamp(ht_decay * 0.01, 0.05, 1);
  ht_rt = clamp(pow(2, ht_tune / 12), 0.25, 4);
  ht_mhz = 208.0 * ht_rt;
  ht_glide = 0.0 * ht_rt;
  ht_gpole = opcoef(fs, 0.05);
  ht_lhz = ht_mhz * 0.652;
  ht_shz = 285.0 * ht_rt;
  ht_mph = 2.674;
  ht_lph = 1.059;
  ht_sph = 0.42;
  ht_me = 1;
  ht_le = 1;
  ht_se = 1;
  ht_uhz0 = ht_mhz * 1.467307692308;
  ht_uph0 = -2.987;
  ht_ue0 = 1;
  ht_up0 = t60coef(fs, 0.8 * ht_dec);
  ht_uhz1 = ht_mhz * 1.662019230769;
  ht_uph1 = 0.618;
  ht_ue1 = 1;
  ht_up1 = t60coef(fs, 0.8 * ht_dec);
  ht_uhz2 = ht_mhz * 1.764423076923;
  ht_uph2 = 1.002;
  ht_ue2 = 1;
  ht_up2 = t60coef(fs, 0.4 * ht_dec);
  ht_uhz3 = ht_mhz * 1.859134615385;
  ht_uph3 = 0.597;
  ht_ue3 = 1;
  ht_up3 = t60coef(fs, 0.36 * ht_dec);
  ht_sne = 1;
  ht_bue = 1;
  ht_tne = 1;
  ht_mpole = t60coef(fs, 0.218 * ht_dec);
  ht_lpole = t60coef(fs, 0.315 * ht_dec);
  ht_spole = t60coef(fs, 0.0125 * ht_dec);
  ht_snp = t60coef(fs, 0.012 * ht_dec);
  ht_bup = t60coef(fs, 0.08 * ht_dec);
  ht_tnp = t60coef(fs, 0.3 * ht_dec);
  ht_br = 0;
  ht_brc = 1 - opcoef(fs, 0.00012);
  ht_sr = 0;
  ht_src = 1 - opcoef(fs, 0.00003);
  ht_snr = 0;
  ht_snrc = 1 - opcoef(fs, 0.0004);
  ht_nr = 0;
  ht_nrc = 1 - opcoef(fs, 0.0015);
  ht_lnh_t12c = clamp(300.0 * ht_rt, 10, fs * 0.45);
  ht_lnh_t12q = max(0.05, 0.70710678);
  ht_lnh_t12w = 6.283185307179586 * ht_lnh_t12c / fs;
  ht_lnh_t12cw = cos(ht_lnh_t12w);
  ht_lnh_t12sw = sin(ht_lnh_t12w);
  ht_lnh_t12al = ht_lnh_t12sw / (2 * ht_lnh_t12q);
  ht_lnh_t12ia = 1 / (1 + ht_lnh_t12al);
  ht_lnh_b0 = (1 + ht_lnh_t12cw) * 0.5 * ht_lnh_t12ia;
  ht_lnh_b1 = -(1 + ht_lnh_t12cw) * ht_lnh_t12ia;
  ht_lnh_b2 = ht_lnh_b0;
  ht_lnh_a1 = -2 * ht_lnh_t12cw * ht_lnh_t12ia;
  ht_lnh_a2 = (1 - ht_lnh_t12al) * ht_lnh_t12ia;
  ht_lnh_z1 = 0;
  ht_lnh_z2 = 0;
  ht_lnl_t13c = clamp(3000.0 * ht_rt, 10, fs * 0.45);
  ht_lnl_t13q = max(0.05, 0.70710678);
  ht_lnl_t13w = 6.283185307179586 * ht_lnl_t13c / fs;
  ht_lnl_t13cw = cos(ht_lnl_t13w);
  ht_lnl_t13sw = sin(ht_lnl_t13w);
  ht_lnl_t13al = ht_lnl_t13sw / (2 * ht_lnl_t13q);
  ht_lnl_t13ia = 1 / (1 + ht_lnl_t13al);
  ht_lnl_b0 = (1 - ht_lnl_t13cw) * 0.5 * ht_lnl_t13ia;
  ht_lnl_b1 = (1 - ht_lnl_t13cw) * ht_lnl_t13ia;
  ht_lnl_b2 = ht_lnl_b0;
  ht_lnl_a1 = -2 * ht_lnl_t13cw * ht_lnl_t13ia;
  ht_lnl_a2 = (1 - ht_lnl_t13al) * ht_lnl_t13ia;
  ht_lnl_z1 = 0;
  ht_lnl_z2 = 0;
  ht_hnh_t14c = clamp(700.0 * ht_rt, 10, fs * 0.45);
  ht_hnh_t14q = max(0.05, 0.70710678);
  ht_hnh_t14w = 6.283185307179586 * ht_hnh_t14c / fs;
  ht_hnh_t14cw = cos(ht_hnh_t14w);
  ht_hnh_t14sw = sin(ht_hnh_t14w);
  ht_hnh_t14al = ht_hnh_t14sw / (2 * ht_hnh_t14q);
  ht_hnh_t14ia = 1 / (1 + ht_hnh_t14al);
  ht_hnh_b0 = (1 + ht_hnh_t14cw) * 0.5 * ht_hnh_t14ia;
  ht_hnh_b1 = -(1 + ht_hnh_t14cw) * ht_hnh_t14ia;
  ht_hnh_b2 = ht_hnh_b0;
  ht_hnh_a1 = -2 * ht_hnh_t14cw * ht_hnh_t14ia;
  ht_hnh_a2 = (1 - ht_hnh_t14al) * ht_hnh_t14ia;
  ht_hnh_z1 = 0;
  ht_hnh_z2 = 0;
  ht_hnl_t15c = clamp(12000.0 * ht_rt, 10, fs * 0.45);
  ht_hnl_t15q = max(0.05, 0.70710678);
  ht_hnl_t15w = 6.283185307179586 * ht_hnl_t15c / fs;
  ht_hnl_t15cw = cos(ht_hnl_t15w);
  ht_hnl_t15sw = sin(ht_hnl_t15w);
  ht_hnl_t15al = ht_hnl_t15sw / (2 * ht_hnl_t15q);
  ht_hnl_t15ia = 1 / (1 + ht_hnl_t15al);
  ht_hnl_b0 = (1 - ht_hnl_t15cw) * 0.5 * ht_hnl_t15ia;
  ht_hnl_b1 = (1 - ht_hnl_t15cw) * ht_hnl_t15ia;
  ht_hnl_b2 = ht_hnl_b0;
  ht_hnl_a1 = -2 * ht_hnl_t15cw * ht_hnl_t15ia;
  ht_hnl_a2 = (1 - ht_hnl_t15al) * ht_hnl_t15ia;
  ht_hnl_z1 = 0;
  ht_hnl_z2 = 0;
  ht_tnh_t16c = clamp(300.0 * ht_rt, 10, fs * 0.45);
  ht_tnh_t16q = max(0.05, 0.70710678);
  ht_tnh_t16w = 6.283185307179586 * ht_tnh_t16c / fs;
  ht_tnh_t16cw = cos(ht_tnh_t16w);
  ht_tnh_t16sw = sin(ht_tnh_t16w);
  ht_tnh_t16al = ht_tnh_t16sw / (2 * ht_tnh_t16q);
  ht_tnh_t16ia = 1 / (1 + ht_tnh_t16al);
  ht_tnh_b0 = (1 + ht_tnh_t16cw) * 0.5 * ht_tnh_t16ia;
  ht_tnh_b1 = -(1 + ht_tnh_t16cw) * ht_tnh_t16ia;
  ht_tnh_b2 = ht_tnh_b0;
  ht_tnh_a1 = -2 * ht_tnh_t16cw * ht_tnh_t16ia;
  ht_tnh_a2 = (1 - ht_tnh_t16al) * ht_tnh_t16ia;
  ht_tnh_z1 = 0;
  ht_tnh_z2 = 0;
  ht_tnl_t17c = clamp(1500.0 * ht_rt, 10, fs * 0.45);
  ht_tnl_t17q = max(0.05, 0.70710678);
  ht_tnl_t17w = 6.283185307179586 * ht_tnl_t17c / fs;
  ht_tnl_t17cw = cos(ht_tnl_t17w);
  ht_tnl_t17sw = sin(ht_tnl_t17w);
  ht_tnl_t17al = ht_tnl_t17sw / (2 * ht_tnl_t17q);
  ht_tnl_t17ia = 1 / (1 + ht_tnl_t17al);
  ht_tnl_b0 = (1 - ht_tnl_t17cw) * 0.5 * ht_tnl_t17ia;
  ht_tnl_b1 = (1 - ht_tnl_t17cw) * ht_tnl_t17ia;
  ht_tnl_b2 = ht_tnl_b0;
  ht_tnl_a1 = -2 * ht_tnl_t17cw * ht_tnl_t17ia;
  ht_tnl_a2 = (1 - ht_tnl_t17al) * ht_tnl_t17ia;
  ht_tnl_z1 = 0;
  ht_tnl_z2 = 0;
  ht_active = 1;
}
if (ht_active > 0) {
  ht_mph = wrap2pi(ht_mph + 6.283185307179586 * (ht_mhz + ht_glide) / fs);
  ht_lph = wrap2pi(ht_lph + 6.283185307179586 * ht_lhz / fs);
  ht_sph = wrap2pi(ht_sph + 6.283185307179586 * ht_shz / fs);
  ht_uph0 = wrap2pi(ht_uph0 + 6.283185307179586 * ht_uhz0 / fs);
  ht_uph1 = wrap2pi(ht_uph1 + 6.283185307179586 * ht_uhz1 / fs);
  ht_uph2 = wrap2pi(ht_uph2 + 6.283185307179586 * ht_uhz2 / fs);
  ht_uph3 = wrap2pi(ht_uph3 + 6.283185307179586 * ht_uhz3 / fs);
  ht_br = ht_br + (1 - ht_br) * ht_brc;
  ht_sr = ht_sr + (1 - ht_sr) * ht_src;
  ht_snr = ht_snr + (1 - ht_snr) * ht_snrc;
  ht_nr = ht_nr + (1 - ht_nr) * ht_nrc;
  ht_main = (sin(ht_mph) + 0.0095 * sin(2 * ht_mph) + 0.0032 * sin(3 * ht_mph)) * ht_me;
  ht_lower = 0.09 * sin(ht_lph) * ht_le;
  ht_strike = 0.71 * sin(ht_sph) * ht_se * ht_sr;
  ht_upper = 0.002617 * sin(ht_uph0) * ht_ue0 + 0.001954 * sin(ht_uph1) * ht_ue1 + 0.003381 * sin(ht_uph2) * ht_ue2 + 0.003546 * sin(ht_uph3) * ht_ue3;
  ht_ln = noise();
  ht_ln1 = ht_lnh_b0 * ht_ln + ht_lnh_z1;
  ht_lnh_z1 = ht_lnh_b1 * ht_ln - ht_lnh_a1 * ht_ln1 + ht_lnh_z2;
  ht_lnh_z2 = ht_lnh_b2 * ht_ln - ht_lnh_a2 * ht_ln1;
  ht_ln2 = ht_lnl_b0 * ht_ln1 + ht_lnl_z1;
  ht_lnl_z1 = ht_lnl_b1 * ht_ln1 - ht_lnl_a1 * ht_ln2 + ht_lnl_z2;
  ht_lnl_z2 = ht_lnl_b2 * ht_ln1 - ht_lnl_a2 * ht_ln2;
  ht_hs = noise();
  ht_hn1 = ht_hnh_b0 * ht_hs + ht_hnh_z1;
  ht_hnh_z1 = ht_hnh_b1 * ht_hs - ht_hnh_a1 * ht_hn1 + ht_hnh_z2;
  ht_hnh_z2 = ht_hnh_b2 * ht_hs - ht_hnh_a2 * ht_hn1;
  ht_hn2 = ht_hnl_b0 * ht_hn1 + ht_hnl_z1;
  ht_hnl_z1 = ht_hnl_b1 * ht_hn1 - ht_hnl_a1 * ht_hn2 + ht_hnl_z2;
  ht_hnl_z2 = ht_hnl_b2 * ht_hn1 - ht_hnl_a2 * ht_hn2;
  ht_tn = noise();
  ht_tn1 = ht_tnh_b0 * ht_tn + ht_tnh_z1;
  ht_tnh_z1 = ht_tnh_b1 * ht_tn - ht_tnh_a1 * ht_tn1 + ht_tnh_z2;
  ht_tnh_z2 = ht_tnh_b2 * ht_tn - ht_tnh_a2 * ht_tn1;
  ht_tn2 = ht_tnl_b0 * ht_tn1 + ht_tnl_z1;
  ht_tnl_z1 = ht_tnl_b1 * ht_tn1 - ht_tnl_a1 * ht_tn2 + ht_tnl_z2;
  ht_tnl_z2 = ht_tnl_b2 * ht_tn1 - ht_tnl_a2 * ht_tn2;
  ht_snap = ht_snr * ht_sne;
  ht_burst = ht_nr * ht_bue;
  ht_exc = ht_ln2 * (0.5 * ht_snap + 0.03 * ht_burst) + ht_hn2 * (0.03 * ht_snap + 0.009 * ht_burst) + ht_tn2 * 0.01 * ht_nr * ht_tne;
  ht_out = ((ht_main + ht_lower + ht_upper) * ht_br + ht_strike + ht_exc) * 0.8;
  ht_me = ht_me * ht_mpole;
  ht_glide = ht_glide * ht_gpole;
  ht_le = ht_le * ht_lpole;
  ht_se = ht_se * ht_spole;
  ht_ue0 = ht_ue0 * ht_up0;
  ht_ue1 = ht_ue1 * ht_up1;
  ht_ue2 = ht_ue2 * ht_up2;
  ht_ue3 = ht_ue3 * ht_up3;
  ht_sne = ht_sne * ht_snp;
  ht_bue = ht_bue * ht_bup;
  ht_tne = ht_tne * ht_tnp;
  if (ht_me <= 0.000005 && 0.09 * ht_le <= 0.000005 && 0.002617 * ht_ue0 <= 0.000005 && 0.001954 * ht_ue1 <= 0.000005 && 0.003381 * ht_ue2 <= 0.000005 && 0.003546 * ht_ue3 <= 0.000005) { ht_active = 0; }
}
// ---- cp ----
cp_fire = 0;
cp_vel = 0;
if (tr_cp != cp_trlast) {
  cp_trlast = tr_cp;
  cp_vel = tr_cp - 128 * floor(tr_cp / 128);
  cp_fire = 1;
}
if (cp_sq > 0) { cp_vel = max(cp_vel, seq_vel); cp_fire = 1; }
if (cp_fire > 0) {
  cp_vg = velgain(cp_vel, acc);
  cp_dec = clamp(cp_decay * 0.01, 0.05, 1);
  cp_rt = clamp(pow(2, cp_tune / 12), 0.5, 2);
  cp_nn = clamp(cp_noise * 0.01, 0, 1);
  cp_nlg = 2 * min(cp_nn, 0.5);
  cp_air = 0;
  if (cp_nn > 0.5) { cp_air = 2 * (cp_nn - 0.5); }
  cp_stp = 44100 * cp_rt / fs;
  cp_tapn = max(1, min(ceil(192 / cp_stp), 384));
  for (k = 0; k < 4; k = k + 1) {
    cp_se = 0;
    for (j = 0; j < 192; j = j + 1) { cp_sv = peek(tbl, k * 192 + j); cp_se = cp_se + cp_sv * cp_sv; }
    cp_re = 0;
    for (j = 0; j < cp_tapn; j = j + 1) {
      cp_ps = j * cp_stp;
      cp_ii = floor(cp_ps);
      cp_fr = cp_ps - cp_ii;
      cp_p0 = 0; cp_p1 = 0; cp_p2 = 0; cp_p3 = 0;
      if (cp_ii - 1 >= 0 && cp_ii - 1 < 192) { cp_p0 = peek(tbl, k * 192 + cp_ii - 1); }
      if (cp_ii >= 0 && cp_ii < 192) { cp_p1 = peek(tbl, k * 192 + cp_ii); }
      if (cp_ii + 1 >= 0 && cp_ii + 1 < 192) { cp_p2 = peek(tbl, k * 192 + cp_ii + 1); }
      if (cp_ii + 2 >= 0 && cp_ii + 2 < 192) { cp_p3 = peek(tbl, k * 192 + cp_ii + 2); }
      cp_f2 = cp_fr * cp_fr;
      cp_f3 = cp_f2 * cp_fr;
      cp_cv = 0.5 * (2 * cp_p1 + (-cp_p0 + cp_p2) * cp_fr + (2 * cp_p0 - 5 * cp_p1 + 4 * cp_p2 - cp_p3) * cp_f2 + (-cp_p0 + 3 * cp_p1 - 3 * cp_p2 + cp_p3) * cp_f3);
      poke(cp_c, cp_cv, j * 4 + k);
      cp_re = cp_re + cp_cv * cp_cv;
    }
    cp_sc = sqrt(cp_se / max(cp_re, 0.00000000000000000001));
    for (j = 0; j < cp_tapn; j = j + 1) { poke(cp_c, peek(cp_c, j * 4 + k) * cp_sc, j * 4 + k); }
  }
  for (j = 0; j < cp_tapn; j = j + 1) {
    cp_g = (noise() + noise() + noise() + noise() + noise() + noise()) * 0.70710678118654752;
    poke(cp_ring, cp_g, cp_pos);
    poke(cp_ring, cp_g, cp_pos + 512);
    cp_pos = cp_pos + 1;
    if (cp_pos >= 512) { cp_pos = 0; }
  }
  cp_blf = 0.425 * 44100 * cp_rt;
  cp_bl = 0;
  if (cp_blf < 0.45 * fs) { cp_bl = 1; }
  cp_la1_t18c = clamp(cp_blf, 10, fs * 0.45);
  cp_la1_t18q = max(0.05, 0.5411961);
  cp_la1_t18w = 6.283185307179586 * cp_la1_t18c / fs;
  cp_la1_t18cw = cos(cp_la1_t18w);
  cp_la1_t18sw = sin(cp_la1_t18w);
  cp_la1_t18al = cp_la1_t18sw / (2 * cp_la1_t18q);
  cp_la1_t18ia = 1 / (1 + cp_la1_t18al);
  cp_la1_b0 = (1 - cp_la1_t18cw) * 0.5 * cp_la1_t18ia;
  cp_la1_b1 = (1 - cp_la1_t18cw) * cp_la1_t18ia;
  cp_la1_b2 = cp_la1_b0;
  cp_la1_a1 = -2 * cp_la1_t18cw * cp_la1_t18ia;
  cp_la1_a2 = (1 - cp_la1_t18al) * cp_la1_t18ia;
  cp_la1_z1 = 0;
  cp_la1_z2 = 0;
  cp_la2_t19c = clamp(cp_blf, 10, fs * 0.45);
  cp_la2_t19q = max(0.05, 1.3065630);
  cp_la2_t19w = 6.283185307179586 * cp_la2_t19c / fs;
  cp_la2_t19cw = cos(cp_la2_t19w);
  cp_la2_t19sw = sin(cp_la2_t19w);
  cp_la2_t19al = cp_la2_t19sw / (2 * cp_la2_t19q);
  cp_la2_t19ia = 1 / (1 + cp_la2_t19al);
  cp_la2_b0 = (1 - cp_la2_t19cw) * 0.5 * cp_la2_t19ia;
  cp_la2_b1 = (1 - cp_la2_t19cw) * cp_la2_t19ia;
  cp_la2_b2 = cp_la2_b0;
  cp_la2_a1 = -2 * cp_la2_t19cw * cp_la2_t19ia;
  cp_la2_a2 = (1 - cp_la2_t19al) * cp_la2_t19ia;
  cp_la2_z1 = 0;
  cp_la2_z2 = 0;
  cp_lb1_t20c = clamp(cp_blf, 10, fs * 0.45);
  cp_lb1_t20q = max(0.05, 0.5411961);
  cp_lb1_t20w = 6.283185307179586 * cp_lb1_t20c / fs;
  cp_lb1_t20cw = cos(cp_lb1_t20w);
  cp_lb1_t20sw = sin(cp_lb1_t20w);
  cp_lb1_t20al = cp_lb1_t20sw / (2 * cp_lb1_t20q);
  cp_lb1_t20ia = 1 / (1 + cp_lb1_t20al);
  cp_lb1_b0 = (1 - cp_lb1_t20cw) * 0.5 * cp_lb1_t20ia;
  cp_lb1_b1 = (1 - cp_lb1_t20cw) * cp_lb1_t20ia;
  cp_lb1_b2 = cp_lb1_b0;
  cp_lb1_a1 = -2 * cp_lb1_t20cw * cp_lb1_t20ia;
  cp_lb1_a2 = (1 - cp_lb1_t20al) * cp_lb1_t20ia;
  cp_lb1_z1 = 0;
  cp_lb1_z2 = 0;
  cp_lb2_t21c = clamp(cp_blf, 10, fs * 0.45);
  cp_lb2_t21q = max(0.05, 1.3065630);
  cp_lb2_t21w = 6.283185307179586 * cp_lb2_t21c / fs;
  cp_lb2_t21cw = cos(cp_lb2_t21w);
  cp_lb2_t21sw = sin(cp_lb2_t21w);
  cp_lb2_t21al = cp_lb2_t21sw / (2 * cp_lb2_t21q);
  cp_lb2_t21ia = 1 / (1 + cp_lb2_t21al);
  cp_lb2_b0 = (1 - cp_lb2_t21cw) * 0.5 * cp_lb2_t21ia;
  cp_lb2_b1 = (1 - cp_lb2_t21cw) * cp_lb2_t21ia;
  cp_lb2_b2 = cp_lb2_b0;
  cp_lb2_a1 = -2 * cp_lb2_t21cw * cp_lb2_t21ia;
  cp_lb2_a2 = (1 - cp_lb2_t21al) * cp_lb2_t21ia;
  cp_lb2_z1 = 0;
  cp_lb2_z2 = 0;
