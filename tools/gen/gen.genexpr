  sd_active = 1;
}
if (sd_active > 0) {
  if (sd_fi >= sd_nf) { sd_active = 0; }
  else {
  sd_tm = sd_fi / fs;
  sd_gate = 1;
  if (sd_dec < 0.999 && sd_tm >= sd_ghold) {
    if (sd_gfade <= 0) { sd_gate = 0; }
    else {
      sd_prog = (sd_tm - sd_ghold) / sd_gfade;
      if (sd_prog >= 1) { sd_gate = 0; }
      else { sd_gate = max(0, (1 + 0.000015881701) * exp(-11.05 * sd_prog) - 0.000015881701); }
    }
  }
  sd_body = 0;
  sd_tt = sd_tm * sd_pr;
  if (sd_tt < 0.249795918367 && sd_tm < sd_sel) {
    sd_fr = 201.09442 * sd_pr + 149.23143 * exp(-sd_tm / 0.0133309);
    sd_att = pow(1 - exp(-sd_tm / 0.0007633316), 3.2748916);
    sd_env = sd_att * exp(-6.9077553 * sd_tt / 0.243);
    sd_tenv = sd_att * exp(-6.9077553 * sd_tm / 0.03);
    sd_imp = 0;
    if (sd_tm >= 0.0002763113 && sd_tm < 0.0013649489) { sd_imp = -0.3000014 * exp(-(sd_tm - 0.0002763113) / 0.0025407782); }
    sd_body = ((0.391 * sd_env + 0.44 * sd_tenv) * sin(sd_bph) + sd_imp) * 0.71 * sd_gate;
    sd_bph = wrap2pi(sd_bph + 6.283185307179586 * sd_fr / fs);
