  sd_b2_t3ia = 1 / (1 + sd_b2_t3al);
  sd_b2_b0 = 0.5 * sd_b2_t3sw * sd_b2_t3ia;
  sd_b2_b1 = 0;
  sd_b2_b2 = -0.5 * sd_b2_t3sw * sd_b2_t3ia;
  sd_b2_a1 = -2 * sd_b2_t3cw * sd_b2_t3ia;
  sd_b2_a2 = (1 - sd_b2_t3al) * sd_b2_t3ia;
  sd_b2_z1 = 0;
  sd_b2_z2 = 0;
  sd_lpa = lpcoef(fs, 19677.396 * sd_col);
  sd_lpz = 0;
