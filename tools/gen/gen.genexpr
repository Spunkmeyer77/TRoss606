  sd_b2_t3q = max(0.05, 0.30369505);
  sd_b2_t3w = 6.283185307179586 * sd_b2_t3c / fs;
  sd_b2_t3cw = cos(sd_b2_t3w);
  sd_b2_t3sw = sin(sd_b2_t3w);
