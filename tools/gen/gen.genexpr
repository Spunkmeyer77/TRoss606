  lt_tnh_a1 = -2 * lt_tnh_t10cw * lt_tnh_t10ia;
  lt_tnh_a2 = (1 - lt_tnh_t10al) * lt_tnh_t10ia;
  lt_tnh_z1 = 0;
  lt_tnh_z2 = 0;
  lt_tnl_t11c = clamp(1500.0 * lt_rt, 10, fs * 0.45);
