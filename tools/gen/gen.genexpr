dcoef(a_fs, a_s) {
  return exp(-1 / (a_fs * max(0.0005, a_s)));
}
opcoef(a_fs, a_s) {
  return exp(-1 / (a_fs * max(0.00001, a_s)));
}
t60coef(a_fs, a_s) {
  return exp(-6.9077553 / (a_fs * max(0.0001, a_s)));
}
lpcoef(a_fs, a_f) {
  return 1 - exp(-6.283185307179586 * clamp(a_f, 10, a_fs * 0.45) / a_fs);
}
wrap2pi(a_x) {
  return a_x - 6.283185307179586 * floor(a_x / 6.283185307179586);
}
velgain(a_v, a_acc) {
  vg_g = 0.3 + 0.7 * min(a_v, 100) / 100;
  if (a_v > 100) {
    vg_g = vg_g * (1 + a_acc);
  }
  return vg_g;
}
lvlgain(a_db) {
  lg_g = 0;
  if (a_db > -69.9) {
    lg_g = pow(10, a_db / 20);
  }
  return lg_g;
}
rsg(a_t, a_on, a_att, a_ho, a_t60) {
  rs_age = a_t - a_on;
  rs_out = 0;
  if (rs_age >= 0) {
    rs_ag = 1;
    if (a_att > 0 && rs_age < a_att) {
      rs_sn = sin(0.5 * 3.141592653589793 * rs_age / a_att);
      rs_ag = rs_sn * rs_sn;
    }
    rs_da = max(rs_age - a_att - a_ho, 0);
    rs_out = rs_ag * exp(-6.9077553 * rs_da / max(a_t60, 0.000001));
  }
  return rs_out;
}
blep(a_t, a_dt) {
  bl_out = 0;
  if (a_t < a_dt) {
    bl_x = a_t / a_dt;
    bl_out = bl_x + bl_x - bl_x * bl_x - 1;
  }
  else if (a_t > 1 - a_dt) {
    bl_x = (a_t - 1) / a_dt;
    bl_out = bl_x * bl_x + bl_x + bl_x + 1;
  }
  return bl_out;
}
rcr(a_t, a_s, a_e) {
  rc_out = 1;
  if (a_t <= a_s) {
    rc_out = 0;
  }
  else if (a_t < a_e) {
    rc_out = 0.5 - 0.5 * cos(3.141592653589793 * (a_t - a_s) / (a_e - a_s));
  }
  return rc_out;
}

