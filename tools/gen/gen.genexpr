    cp_c1 = cp_c1 + peek(cp_c, cp_ci + 1) * cp_s;
    cp_c2 = cp_c2 + peek(cp_c, cp_ci + 2) * cp_s;
    cp_c3 = cp_c3 + peek(cp_c, cp_ci + 3) * cp_s;
