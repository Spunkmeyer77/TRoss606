  sd_b1_t2ia = 1 / (1 + sd_b1_t2al);
  sd_b1_b0 = 0.5 * sd_b1_t2sw * sd_b1_t2ia;
  sd_b1_b1 = 0;
  sd_b1_b2 = -0.5 * sd_b1_t2sw * sd_b1_t2ia;
  sd_b1_a1 = -2 * sd_b1_t2cw * sd_b1_t2ia;
  sd_b1_a2 = (1 - sd_b1_t2al) * sd_b1_t2ia;
  sd_b1_z1 = 0;
  sd_b1_z2 = 0;
