  lt_ln = noise();
  lt_ln1 = lt_lnh_b0 * lt_ln + lt_lnh_z1;
  lt_lnh_z1 = lt_lnh_b1 * lt_ln - lt_lnh_a1 * lt_ln1 + lt_lnh_z2;
  lt_lnh_z2 = lt_lnh_b2 * lt_ln - lt_lnh_a2 * lt_ln1;
