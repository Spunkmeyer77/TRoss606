  lt_fsl_b2 = lt_fsl_b0;
  lt_fsl_a1 = -2 * lt_fsl_t9cw * lt_fsl_t9ia;
  lt_fsl_a2 = (1 - lt_fsl_t9al) * lt_fsl_t9ia;
  lt_fsl_z1 = 0;
  lt_fsl_z2 = 0;
  lt_tnh_t10c = clamp(300.0 * lt_rt, 10, fs * 0.45);
  lt_tnh_t10q = max(0.05, 0.70710678);
  lt_tnh_t10w = 6.283185307179586 * lt_tnh_t10c / fs;
  lt_tnh_t10cw = cos(lt_tnh_t10w);
  lt_tnh_t10sw = sin(lt_tnh_t10w);
