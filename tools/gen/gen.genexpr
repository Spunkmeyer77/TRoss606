  lt_lnh_t4w = 6.283185307179586 * lt_lnh_t4c / fs;
  lt_lnh_t4cw = cos(lt_lnh_t4w);
  lt_lnh_t4sw = sin(lt_lnh_t4w);
  lt_lnh_t4al = lt_lnh_t4sw / (2 * lt_lnh_t4q);
  lt_lnh_t4ia = 1 / (1 + lt_lnh_t4al);
  lt_lnh_b0 = (1 + lt_lnh_t4cw) * 0.5 * lt_lnh_t4ia;
  lt_lnh_b1 = -(1 + lt_lnh_t4cw) * lt_lnh_t4ia;
  lt_lnh_b2 = lt_lnh_b0;
  lt_lnh_a1 = -2 * lt_lnh_t4cw * lt_lnh_t4ia;
  lt_lnh_a2 = (1 - lt_lnh_t4al) * lt_lnh_t4ia;
  lt_lnh_z1 = 0;
  lt_lnh_z2 = 0;
  lt_lnl_t5c = clamp(3000.0 * lt_rt, 10, fs * 0.45);
  lt_lnl_t5q = max(0.05, 0.70710678);
  lt_lnl_t5w = 6.283185307179586 * lt_lnl_t5c / fs;
  lt_lnl_t5cw = cos(lt_lnl_t5w);
  lt_lnl_t5sw = sin(lt_lnl_t5w);
  lt_lnl_t5al = lt_lnl_t5sw / (2 * lt_lnl_t5q);
  lt_lnl_t5ia = 1 / (1 + lt_lnl_t5al);
  lt_lnl_b0 = (1 - lt_lnl_t5cw) * 0.5 * lt_lnl_t5ia;
  lt_lnl_b1 = (1 - lt_lnl_t5cw) * lt_lnl_t5ia;
  lt_lnl_b2 = lt_lnl_b0;
  lt_lnl_a1 = -2 * lt_lnl_t5cw * lt_lnl_t5ia;
  lt_lnl_a2 = (1 - lt_lnl_t5al) * lt_lnl_t5ia;
  lt_lnl_z1 = 0;
  lt_lnl_z2 = 0;
  lt_hnh_t6c = clamp(700.0 * lt_rt, 10, fs * 0.45);
  lt_hnh_t6q = max(0.05, 0.70710678);
  lt_hnh_t6w = 6.283185307179586 * lt_hnh_t6c / fs;
  lt_hnh_t6cw = cos(lt_hnh_t6w);
  lt_hnh_t6sw = sin(lt_hnh_t6w);
  lt_hnh_t6al = lt_hnh_t6sw / (2 * lt_hnh_t6q);
  lt_hnh_t6ia = 1 / (1 + lt_hnh_t6al);
  lt_hnh_b0 = (1 + lt_hnh_t6cw) * 0.5 * lt_hnh_t6ia;
