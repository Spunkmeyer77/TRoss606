acc = accent * 0.01;
seq_hit = 0;
seq_s = 0;
if (seqtick != ticklast) {
  ticklast = seqtick;
  if (seqon > 0) { seq_hit = 1; seq_s = stp; }
}
seq_b = pow(2, seq_s);
seq_acc = seq_hit * (floor(m_ac / seq_b) - 2 * floor(m_ac / (2 * seq_b)));
seq_vel = 100;
if (seq_acc > 0) { seq_vel = 127; }
bd_sq = seq_hit * (floor(m_bd / seq_b) - 2 * floor(m_bd / (2 * seq_b)));
sd_sq = seq_hit * (floor(m_sd / seq_b) - 2 * floor(m_sd / (2 * seq_b)));
lt_sq = seq_hit * (floor(m_lt / seq_b) - 2 * floor(m_lt / (2 * seq_b)));
ht_sq = seq_hit * (floor(m_ht / seq_b) - 2 * floor(m_ht / (2 * seq_b)));
cp_sq = seq_hit * (floor(m_cp / seq_b) - 2 * floor(m_cp / (2 * seq_b)));
ch_sq = seq_hit * (floor(m_ch / seq_b) - 2 * floor(m_ch / (2 * seq_b)));
oh_sq = seq_hit * (floor(m_oh / seq_b) - 2 * floor(m_oh / (2 * seq_b)));
cy_sq = seq_hit * (floor(m_cy / seq_b) - 2 * floor(m_cy / (2 * seq_b)));
if ((tr_ch != ch_trlast || ch_sq > 0) && oh_active > 0) { oh_chk = dcoef(fs, 0.004); }
// ---- bd ----
bd_fire = 0;
bd_vel = 0;
if (tr_bd != bd_trlast) {
  bd_trlast = tr_bd;
  bd_vel = tr_bd - 128 * floor(tr_bd / 128);
  bd_fire = 1;
}
if (bd_sq > 0) { bd_vel = max(bd_vel, seq_vel); bd_fire = 1; }
if (bd_fire > 0) {
  bd_vg = velgain(bd_vel, acc);
  bd_T = clamp(bd_attack * 0.01, 0, 1);
  bd_D = clamp(bd_decay * 0.01, 0, 1);
  bd_dec = -1.75 + 4.75 * bd_D * bd_D;
  bd_amt = 0.1 + bd_T * 0.5;
  bd_ratio = pow(2, bd_tune / 12);
  bd_start = (120 + (0.28 - 0.5) * 16) * bd_ratio;
  bd_end = (53 + (0.28 - 0.5) * 8) * bd_ratio;
  bd_ts = clamp(bd_amt, 0, 1.5);
  bd_thud = clamp(bd_ts * bd_ts, 0, 1.5);
  bd_pd = 0.022 + (0.008 - 0.022) * clamp(bd_thud, 0, 1);
  bd_amp = 0.92 + bd_thud * 0.22 + 0.08;
  bd_ph = -0.33 * 3.141592653589793;
  bd_hz = bd_start * (1 + bd_thud * 0.28);
  bd_tg = bd_end;
  bd_ampc = dcoef(fs, 0.22 + bd_dec * 0.12);
  bd_pc = 1 - exp(-1 / (fs * max(0.0005, bd_pd)));
  bd_cc = dcoef(fs, 0.002 + bd_amt * 0.0045 + bd_amt * 0.004);
  bd_ce = max(bd_ce, 0.02 + bd_amt * 0.06 + bd_amt * 0.28 + 0.02);
  bd_ic = dcoef(fs, 0.0008 + bd_amt * 0.008);
  bd_ie = max(bd_ie, 0.02 + bd_amt * 0.55 + bd_thud * 0.08 + 0.04);
  bd_bla = lpcoef(fs, 620 + (1200 - 620) * 0.34);
  bd_cla = lpcoef(fs, 1400);
  bd_ila = lpcoef(fs, 2600);
  bd_hp_t1c = clamp(1350, 10, fs * 0.45);
  bd_hp_t1q = max(0.05, 0.707);
  bd_hp_t1w = 6.283185307179586 * bd_hp_t1c / fs;
  bd_hp_t1cw = cos(bd_hp_t1w);
  bd_hp_t1sw = sin(bd_hp_t1w);
  bd_hp_t1al = bd_hp_t1sw / (2 * bd_hp_t1q);
  bd_hp_t1ia = 1 / (1 + bd_hp_t1al);
  bd_hp_b0 = (1 + bd_hp_t1cw) * 0.5 * bd_hp_t1ia;
  bd_hp_b1 = -(1 + bd_hp_t1cw) * bd_hp_t1ia;
  bd_hp_b2 = bd_hp_b0;
  bd_hp_a1 = -2 * bd_hp_t1cw * bd_hp_t1ia;
  bd_hp_a2 = (1 - bd_hp_t1al) * bd_hp_t1ia;
  bd_last = 0;
  bd_active = 1;
  bd_sil = 0;
}
if (bd_active > 0) {
  bd_hz = bd_hz + (bd_tg - bd_hz) * bd_pc;
  bd_ph = bd_ph + 6.283185307179586 * bd_hz / fs;
  if (bd_ph >= 6.283185307179586) { bd_ph = bd_ph - 6.283185307179586; }
  bd_raw = sin(bd_ph) * bd_amp;
  bd_amp = bd_amp * bd_ampc;
  if (bd_amp < 0.000001) { bd_amp = 0; }
  bd_blz = bd_blz + bd_bla * (bd_raw - bd_blz);
  bd_nx = noise();
  bd_n = bd_nx - bd_nin + 0.995 * bd_nout;
  bd_nin = bd_nx;
  bd_nout = bd_n;
  bd_clz = bd_clz + bd_cla * (bd_n - bd_clz);
  bd_ce = bd_ce * bd_cc;
  if (bd_ce < 0.000001) { bd_ce = 0; }
  bd_dl = bd_raw - bd_last;
  bd_last = bd_raw;
  bd_hpo = bd_hp_b0 * bd_dl + bd_hp_z1;
  bd_hp_z1 = bd_hp_b1 * bd_dl - bd_hp_a1 * bd_hpo + bd_hp_z2;
  bd_hp_z2 = bd_hp_b2 * bd_dl - bd_hp_a2 * bd_hpo;
  bd_ilz = bd_ilz + bd_ila * (bd_hpo - bd_ilz);
  bd_ie = bd_ie * bd_ic;
  if (bd_ie < 0.000001) { bd_ie = 0; }
  bd_sum = bd_blz * 0.938 + bd_clz * bd_ce * (0.06 + bd_amt * 0.9) + bd_ilz * bd_ie * (0.08 + bd_amt * 2.2);
  bd_sh = tanh(bd_sum * 1.1416);
  bd_y = bd_sh - bd_dcx + 0.995 * bd_dcy;
  bd_dcx = bd_sh;
  bd_dcy = bd_y;
  bd_out = bd_y * 0.7;
  if (bd_amp > 0.000001 || bd_ce > 0.000001 || bd_ie > 0.000001) { bd_sil = 0; }
  else if (abs(bd_out) < 0.00001) { bd_sil = bd_sil + 1; if (bd_sil >= 32) { bd_active = 0; } }
  else { bd_sil = 0; }
}
// ---- sd ----
sd_fire = 0;
sd_vel = 0;
if (tr_sd != sd_trlast) {
  sd_trlast = tr_sd;
  sd_vel = tr_sd - 128 * floor(tr_sd / 128);
  sd_fire = 1;
}
if (sd_sq > 0) { sd_vel = max(sd_vel, seq_vel); sd_fire = 1; }
if (sd_fire > 0) {
  sd_vg = velgain(sd_vel, acc);
  sd_dec = clamp(sd_decay * 0.01, 0.01, 1);
  sd_pr = clamp(pow(2, sd_tune / 12), 0.25, 4);
  sd_snap = clamp(sd_snappy * 0.01, 0, 1);
  sd_col = 1;
  sd_sel = 0.370136054422 * sd_dec;
  if (sd_dec >= 0.999) { sd_sel = 0.370136054422; }
  sd_rem = max(0, 0.370136054422 - sd_sel);
  sd_gfade = min(sd_sel, sd_rem);
  sd_ghold = max(0, sd_sel - sd_gfade);
  sd_nf = max(1, ceil(sd_sel * fs));
  sd_fi = 0;
  sd_bph = 1.1711004;
  sd_rph = -1.1;
