  lt_sr = 0;
  lt_src = 1 - opcoef(fs, 0.00015);
  lt_snr = 0;
  lt_snrc = 1 - opcoef(fs, 0.0004);
  lt_nr = 0;
  lt_nrc = 1 - opcoef(fs, 0.0015);
